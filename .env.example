# Copy to .env and fill in values.

# Socrata (optional; avoids throttling) - https://data.cambridgema.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Analytics warehouse (container cpd_warehouse)
WAREHOUSE_USER=cpd_admin
WAREHOUSE_PASSWORD=change-me
WAREHOUSE_DB=cpd_insights
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433

# Metabase application database (container cpd_mb_appdb)
MB_APPDB_USER=metabase
MB_APPDB_PASSWORD=change-me-too
MB_APPDB_NAME=metabase_app

# Prefect reads this file too; disables the local server's telemetry heartbeat
PREFECT_SERVER_ANALYTICS_ENABLED=false
